{
  "name": "wedding-dream-wishlist-local-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.22.3 <25"
  },
  "scripts": {
    "dev": "node scripts/run-local.mjs dev",
    "build": "next build",
    "start": "node scripts/run-local.mjs start",
    "start:production": "node --experimental-strip-types scripts/run-production.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "demo:seed": "node --experimental-strip-types scripts/seed.ts",
    "demo:reset": "node --experimental-strip-types scripts/seed.ts --reset-synthetic-demo",
    "demo:backup": "node --experimental-strip-types scripts/backup.ts",
    "auth:mailbox": "node scripts/mailbox.mjs",
    "auth:deliver": "node --experimental-strip-types scripts/send-email.ts",
    "db:local": "node scripts/local-postgres.mjs",
    "db:migrate": "node --experimental-strip-types scripts/migrate.ts"
  },
  "dependencies": {
    "better-auth": "1.7.21",
    "next": "16.4.6",
    "pg": "8.23.1",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.14.0",
    "eslint-config-next": "16.4.6",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
}
