# Documentation only: npm run dev/start sets the local demo gate and loopback origin.
# Do not put credentials in NEXT_PUBLIC_* variables.
# The local launcher creates data\local-auth-secret.txt automatically; never commit/share it.
# BETTER_AUTH_SECRET is server-only and supplied by the launcher.
DEMO_MODE=local-only
DEMO_PORT=4317
# Local PostgreSQL credentials are generated in ignored data\local-postgres.json.
# Hosted values belong only in the provider's secure server configuration, never chat/git.
# DATABASE_URL=postgresql://RUNTIME_ROLE:PASSWORD@DATABASE_HOST/APP_DATABASE?sslmode=verify-full
# MIGRATION_DATABASE_URL=postgresql://MIGRATION_ROLE:PASSWORD@DATABASE_HOST/APP_DATABASE?sslmode=verify-full
# DATABASE_RUNTIME_ROLE=app_runtime
# Production identity preparation ONLY: not a launch approval or a live-payment configuration.
# Do not combine APP_ENV=production with DEMO_MODE.
# APP_ENV=production
# APP_ORIGIN=https://YOUR_APPROVED_HOST
# BETTER_AUTH_SECRET=GENERATE_48_RANDOM_BYTES_AS_96_HEX_CHARACTERS
# EMAIL_OUTBOX_KEY=GENERATE_A_SEPARATE_32_RANDOM_BYTES_AS_64_HEX_CHARACTERS
# EMAIL_FROM=accounts@YOUR_VERIFIED_DOMAIN
# EMAIL_SENDER_VERIFIED=yes
# EMAIL_DELIVERY_APPROVED=resend-free
# RESEND_API_KEY=SERVER_SECRET_FOR_WORKER_ONLY
# Keep mail approval unset until the owner approves provider/terms/region/free-plan/sender.
# No real UPI or payment-provider credentials are supported yet.
