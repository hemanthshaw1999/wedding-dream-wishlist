# REFERENCE ONLY. Contains no working credentials; unchanged values must not start production.
# CODEX-HANDOFF.md defines each value, service scope, implementation gap and acceptance check.
# Enter actual secrets directly into the approved provider's server-side secret store.
# Do not commit populated copies, paste secrets into chat or put secrets in NEXT_PUBLIC_*.
# This file is NOT automatically loaded by Node, npm or Next.js.
# Do not copy all service scopes into a single application's environment.

# WEB APPLICATION
# Delete DEMO_MODE from the hosted environment; do not copy the local .env.example.
APP_ENV=production
APP_ORIGIN=https://replace-with-approved-host.example.invalid
DATABASE_URL=postgresql://replace_runtime_role:replace_via_secret_store@replace-db.example.invalid:5432/replace_db?sslmode=verify-full
BETTER_AUTH_SECRET=REPLACE_WITH_48_INDEPENDENT_RANDOM_BYTES_AS_96_HEX_CHARACTERS
EMAIL_OUTBOX_KEY=REPLACE_WITH_32_INDEPENDENT_RANDOM_BYTES_AS_64_HEX_CHARACTERS
EMAIL_FROM=accounts@replace-with-verified-domain.example.invalid
# Leave these blank until provider/free-plan/data-processing approval and actual sender verification.
EMAIL_DELIVERY_APPROVED=
EMAIL_SENDER_VERIFIED=
# Leave blank until the owner explicitly approves live direct-UPI payments. Exact value when
# approved: yes. Operator attestation only: every wishlist still needs the reauthenticated,
# reviewed per-wishlist activation, and this value alone cannot create/bind recipient
# instructions, convert demo history or move money. Unset disables all live payment behavior.
LIVE_UPI_APPROVED=
# Standalone server only, behind a trusted HTTPS reverse proxy. Not a serverless adapter setting.
PORT=3000
# Also set for the build job to disable Next.js telemetry.
NEXT_TELEMETRY_DISABLED=1

# EMAIL WORKER ONLY
# Supply APP_ENV, APP_ORIGIN and EMAIL_* from the same environment as the web app.
# DATABASE_URL must use a distinct email-only role for the same database, not the web app URL.
# The worker does not need BETTER_AUTH_SECRET or a schema-owner credential.
# RESEND_API_KEY=REPLACE_WITH_APPROVED_DOMAIN_SCOPED_SEND_ONLY_PROVIDER_KEY
# A separate scheduled adapter is provided in deploy\mail-worker; it is not deployed.
# Verify free-tier compute/bandwidth budgets before enabling minute polling. One invocation handles one job.

# MIGRATION JOB ONLY
# APP_ENV=production
# MIGRATION_DATABASE_URL=postgresql://replace_migration_role:replace_via_secret_store@replace-db.example.invalid:5432/replace_db?sslmode=verify-full
# DATABASE_RUNTIME_ROLE=replace_runtime_role
# DATABASE_EMAIL_ROLE=replace_email_only_role
# Provision the database and distinct roles first. npm run db:migrate does not create them.
# Never give MIGRATION_DATABASE_URL to the web app, worker or browser.

# LIVE_UPI_APPROVED is an approval attestation, not an activation switch: it cannot activate
# any wishlist by itself. Reviewed per-wishlist activation is always additionally required.
# Recipient setup, funding policy and live-payment behavior require code; see CODEX-HANDOFF.md.
